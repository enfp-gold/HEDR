      segment.title = card.querySelector('h2').innerText;
      segment.addEventListener('click', () => {
        card.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
      progressBarContainer.appendChild(segment);
    });

    const segments = progressBarContainer.querySelectorAll('.progress-bar-segment');

    window.addEventListener('scroll', () => {
      let currentIdx = 0;
      cards.forEach((card, index) => {
        const rect = card.getBoundingClientRect();
        if (rect.top <= window.innerHeight / 2) {
          currentIdx = index;
        }
      });

      segments.forEach((seg, index) => {
        if (index <= currentIdx) {
          seg.classList.add('active');
        } else {
          seg.classList.remove('active');
        }
      });
    });

    let selectedEventType = 'trust_endorsement';
    let authenticatedUser = null;
    let cachedLedgerRows = [];

    window.addEventListener('DOMContentLoaded', async () => {
      try {
        if (typeof window.Pi !== 'undefined') {
          window.Pi.init({ version: "2.0", sandbox: false });
          
          const scopes = ['username', 'payments'];
          function onIncompletePaymentFound(payment) {
            console.warn("Incomplete payment found:", payment);
          }

          window.Pi.authenticate(scopes, onIncompletePaymentFound).then(auth => {
            authenticatedUser = auth.user;
            document.getElementById('authStatus').innerText = '🟢 Authenticated';
            document.getElementById('authStatus').style.color = '#10b981';
            
            const username = auth.user.username || 'Unknown';
            const uid = auth.user.uid || 'N/A';
            document.getElementById('userIdDisplay').innerText = username;
            document.getElementById('walletAddressDisplay').innerText = uid;

            loadLedger();
          }).catch(err => {
            console.error("Pi Authentication error:", err);
            document.getElementById('authStatus').innerText = '❌ Authentication Failed';
            document.getElementById('authStatus').style.color = '#ef4444';
            document.getElementById('walletAddressDisplay').innerText = 'Authentication failed';
          });
        } else {
          document.getElementById('authStatus').innerText = '❌ Pi SDK Not Found';
          document.getElementById('authStatus').style.color = '#ef4444';
          document.getElementById('walletAddressDisplay').innerText = 'Pi SDK unavailable';
        }
      } catch (e) {
        console.error("Pi Init exception:", e);
      }
    });

    document.querySelectorAll('.event-card').forEach(card => {
      card.addEventListener('click', () => {
        document.querySelectorAll('.event-card').forEach(c => c.classList.remove('active'));
        card.classList.add('active');
        selectedEventType = card.getAttribute('data-type');
      });
    });

    document.getElementById('publishBtn').addEventListener('click', async () => {
      const resultBox = document.getElementById('publishResult');
      if (!authenticatedUser) {
        resultBox.className = 'result-box error';
        resultBox.innerText = '❌ Error: User not authenticated with Pi Network yet.';
        return;
      }

      const commentInput = document.getElementById('eventComment').value.trim();
      let metadataObj = { comment: commentInput };
      try {
        if (commentInput.startsWith('{') && commentInput.endsWith('}')) {
          metadataObj = JSON.parse(commentInput);
        }
      } catch (e) {
        metadataObj = { text: commentInput };
      }

      if (typeof window.Pi === 'undefined' || !window.Pi.createPayment) {
        resultBox.className = 'result-box error';
        resultBox.innerText = '❌ Error: Pi Network SDK / createPayment is not available.';
        return;
      }

      resultBox.style.display = 'block';
      resultBox.className = 'result-box';
      resultBox.style.background = '#e0f2fe';
      resultBox.style.color = '#0369a1';
      resultBox.innerText = '⏳ Initializing Pi Payment...';

      try {
        window.Pi.createPayment({
          amount: 1.00,
          memo: "HEDR Trust Event Publication",
          metadata: { eventType: selectedEventType, ...metadataObj },
        }, {
          onReadyForServerApproval: async (paymentId) => {
            console.log("Ready for server approval:", paymentId);
            try {
              const res = await fetch('/api/payments/approve', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ paymentId })
              });

              // =========================================================
              // 🔴 [ADDED]: ตรวจสอบ HTTP Status 401 Unauthorized ก่อน parse JSON
              // =========================================================
              if (res.status === 401) {
                console.error("Server approval 401: Unauthorized");
                resultBox.className = 'result-box error';
                resultBox.innerText = '❌ 401 Unauthorized: กรุณาเปิดแอป Pi Network ไปที่ Pi Utilities -> Authorize Sandbox แล้วใส่รหัสผ่านก่อนดำเนินการครับ';
                alert("กรุณา Authorize Sandbox ในแอป Pi Network ก่อนทำการชำระเงิน!");
                return;
              }

              const resJson = await res.json();
              if (!res.ok) {
                console.error("Server approval failed:", resJson);
                resultBox.className = 'result-box error';
                resultBox.innerText = '❌ Approval Failed: ' + JSON.stringify(resJson);
              }
            } catch (err) {
              console.error("Approve request failed:", err);
              resultBox.className = 'result-box error';
              resultBox.innerText = '❌ Approve Request Error: ' + err.message;
            }
          },
          onReadyForServerCompletion: async (paymentId, txid) => {
            resultBox.innerText = '⏳ Payment successful! Completing transaction...';
            
            try {
              await fetch('/api/payments/complete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ paymentId, txid })
              });
            } catch (err) {
              console.error("Complete request failed:", err);
            }

            metadataObj.pi_txid = txid;
            metadataObj.payment_id = paymentId;

            try {
              const res = await fetch('/api/publish', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  user_id: authenticatedUser.uid || authenticatedUser.username,
                  type: selectedEventType,
                  metadata: metadataObj
                })
              });
              const json = await res.json();
              if (res.ok) {
                resultBox.className = 'result-box success';
                resultBox.innerText = '🎉 Success! Paid and published event ID: ' + (json.data?.[0]?.id || 'Recorded');
                document.getElementById('eventComment').value = '';
                loadLedger(); 
              } else {
                resultBox.className = 'result-box error';
                resultBox.innerText = '❌ Failed to save event: ' + (json.error || 'Unknown error');
              }
            } catch (err) {
              resultBox.className = 'result-box error';
              resultBox.innerText = '❌ Network Error: ' + err.message;
            }
          },
          onCancel: () => {
            resultBox.className = 'result-box error';
            resultBox.innerText = '❌ Payment cancelled by user.';
          },
          onError: (error) => {
            resultBox.className = 'result-box error';
            resultBox.innerText = '❌ Payment Error: ' + (error.message || JSON.stringify(error));
          }
        });
      } catch (err) {
        resultBox.className = 'result-box error';
        resultBox.innerText = '❌ Pi Payment Exception: ' + err.message;
      }
    });

    document.getElementById('loadLedgerBtn').addEventListener('click', loadLedger);

    async function loadLedger() {
      try {
        const res = await fetch('/api/ledger');
        if (res.ok) {
          const data = await res.json();
          if (Array.isArray(data)) {
            cachedLedgerRows = data;
            renderLedgerTable(cachedLedgerRows);
            updateNeuralLine(cachedLedgerRows);
            updateGasOptimizationStats(cachedLedgerRows);
            updateTrustS2FStats(cachedLedgerRows);
          }
        }
      } catch (e) {
        console.error('Failed to load ledger stream:', e);
      }
    }

    function renderLedgerTable(rows) {
      const tbody = document.getElementById('ledgerTableBody');
      if (Array.isArray(rows) && rows.length > 0) {
        tbody.innerHTML = rows.map(r => 
          '<tr>' +
            '<td>' + (r.user_id && r.user_id.length > 10 ? r.user_id.substring(0, 8) + '...' : (r.user_id || 'Unknown')) + '</td>' +
            '<td><span class="badge">' + r.type + '</span></td>' +
            '<td>' + new Date(r.created_at).toLocaleTimeString() + '</td>' +
          '</tr>'
        ).join('');
      } else {
        tbody.innerHTML = '<tr><td colspan="3" style="text-align: center; color: var(--text-sub);">No records found</td></tr>';
      }
    }

    function updateNeuralLine(rows) {}
    function updateGasOptimizationStats(rows) {}
    function updateTrustS2FStats(rows) {}
  </script>
</body>
</html>`;

    // 4. ส่งออกหน้าเว็บ HTML Response
    return new Response(html, {
      headers: { 'Content-Type': 'text/html; charset=utf-8' }
    });
  }
};
