export default {
  async fetch(request, env, ctx) {
    const url = new URL(request.url);

    // 1. กำหนด CORS Headers สำหรับ API Responses
    const corsHeaders = {
      'Access-Control-Allow-Origin': '*',
      'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
      'Access-Control-Allow-Headers': 'Content-Type, Authorization',
    };

    // 2. จัดการ OPTIONS Preflight Request
    if (request.method === 'OPTIONS') {
      return new Response(null, { headers: corsHeaders });
    }

    // 3. จัดการและทำ Clean ค่า Environment Variables ป้องกัน Format ผิดพลาด
    const rawSupabaseUrl = env.SUPABASE_URL ? env.SUPABASE_URL.trim().replace(/^:\s*/, '') : '';
    const supabaseUrl = rawSupabaseUrl.replace(/\/+$/, '');
    const supabaseKey = env.SUPABASE_KEY ? env.SUPABASE_KEY.trim() : '';
    const piApiKey = env.PI_API_KEY ? env.PI_API_KEY.trim() : '';

    // ==========================================
    // API 1: Publish Trust Event to Supabase
    // ==========================================
    if (url.pathname === '/api/publish' && request.method === 'POST') {
      try {
        const body = await request.json();
        
        if (!body.user_id) {
          return new Response(JSON.stringify({ error: 'Unauthorized: Missing User ID' }), { 
            status: 401, 
            headers: { 'Content-Type': 'application/json', ...corsHeaders } 
          });
        }

        const response = await fetch(`${supabaseUrl}/rest/v1/trust_events`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'apikey': supabaseKey,
            'Authorization': `Bearer ${supabaseKey}`,
            'Prefer': 'return=representation'
          },
          body: JSON.stringify({
            user_id: body.user_id,
            type: body.type,
            metadata: body.metadata
          })
        });

        if (!response.ok) {
          const errText = await response.text();
          return new Response(JSON.stringify({ error: errText }), { 
            status: response.status, 
            headers: { 'Content-Type': 'application/json', ...corsHeaders } 
          });
        }

        const data = await response.json();
        return new Response(JSON.stringify({ success: true, data }), { 
          status: 200,
          headers: { 'Content-Type': 'application/json', ...corsHeaders } 
        });
      } catch (err) {
        return new Response(JSON.stringify({ error: err.message }), { 
          status: 500, 
          headers: { 'Content-Type': 'application/json', ...corsHeaders } 
        });
      }
    }

    // ==========================================
    // API 2: Fetch Ledger from Supabase
    // ==========================================
    if (url.pathname === '/api/ledger' && request.method === 'GET') {
      try {
        if (!supabaseUrl || !supabaseKey) {
          return new Response(JSON.stringify([]), {
            status: 200,
            headers: { 'Content-Type': 'application/json', ...corsHeaders }
          });
        }

        const response = await fetch(`${supabaseUrl}/rest/v1/trust_events?select=*&order=id.desc&limit=100`, {
          method: 'GET',
          headers: {
            'apikey': supabaseKey,
            'Authorization': `Bearer ${supabaseKey}`
          }
        });

        if (!response.ok) {
          return new Response(JSON.stringify([]), {
            status: 200,
            headers: { 'Content-Type': 'application/json', ...corsHeaders }
          });
        }

        const data = await response.json();
        return new Response(JSON.stringify(data), { 
          status: 200,
          headers: { 'Content-Type': 'application/json', ...corsHeaders } 
        });
      } catch (err) {
        return new Response(JSON.stringify([]), { 
          status: 200, 
          headers: { 'Content-Type': 'application/json', ...corsHeaders } 
        });
      }
    }

    // ==========================================
    // API 3: Pi Payment Approve
    // ==========================================
    if (url.pathname === '/api/payments/approve' && request.method === 'POST') {
      try {
        const { paymentId } = await request.json();

        if (!paymentId) {
          return new Response(JSON.stringify({ error: 'Missing paymentId' }), {
            status: 400,
            headers: { 'Content-Type': 'application/json', ...corsHeaders }
          });
        }

        if (!piApiKey) {
          return new Response(JSON.stringify({ error: 'Server misconfiguration: PI_API_KEY is missing' }), {
            status: 500,
            headers: { 'Content-Type': 'application/json', ...corsHeaders }
          });
        }

        const piResponse = await fetch(`https://api.minepi.com/v2/payments/${paymentId}/approve`, {
          method: 'POST',
          headers: {
            'Authorization': `Key ${piApiKey}`,
            'Content-Type': 'application/json'
          }
        });

        const piData = await piResponse.json();

        if (!piResponse.ok) {
          return new Response(JSON.stringify({ error: 'Pi Approve failed', details: piData }), {
            status: piResponse.status,
            headers: { 'Content-Type': 'application/json', ...corsHeaders }
          });
        }

        return new Response(JSON.stringify({ success: true, data: piData }), {
          status: 200,
          headers: { 'Content-Type': 'application/json', ...corsHeaders }
        });
      } catch (err) {
        return new Response(JSON.stringify({ error: err.message }), {
          status: 500,
          headers: { 'Content-Type': 'application/json', ...corsHeaders }
        });
      }
    }

    // ==========================================
    // API 4: Pi Payment Complete
    // ==========================================
    if (url.pathname === '/api/payments/complete' && request.method === 'POST') {
      try {
        const { paymentId, txid } = await request.json();

        if (!paymentId || !txid) {
          return new Response(JSON.stringify({ error: 'Missing paymentId or txid' }), {
            status: 400,
            headers: { 'Content-Type': 'application/json', ...corsHeaders }
          });
        }

        const piResponse = await fetch(`https://api.minepi.com/v2/payments/${paymentId}/complete`, {
          method: 'POST',
          headers: {
            'Authorization': `Key ${piApiKey}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ txid })
        });

        const piData = await piResponse.json();

        if (!piResponse.ok) {
          return new Response(JSON.stringify({ error: 'Pi Complete failed', details: piData }), {
            status: piResponse.status,
            headers: { 'Content-Type': 'application/json', ...corsHeaders }
          });
        }

        return new Response(JSON.stringify({ success: true, data: piData }), {
          status: 200,
          headers: { 'Content-Type': 'application/json', ...corsHeaders }
        });
      } catch (err) {
        return new Response(JSON.stringify({ error: err.message }), {
          status: 500,
          headers: { 'Content-Type': 'application/json', ...corsHeaders }
        });
      }
    }

    // ==========================================
